    @SuppressLint("SetJavaScriptEnabled")
    private fun ensureActiveWebView(): WebView {
        activeWebView?.let { return it }
        // Uses Presentation's displayId 1 context so Chromium renders desktop layouts at 1280x800 @ 160dpi
        val wv = WebView(context).apply {
            settings.javaScriptEnabled = true
            settings.domStorageEnabled = true
            settings.useWideViewPort = true
            settings.loadWithOverviewMode = true
            settings.setSupportZoom(true)
            settings.builtInZoomControls = true
            settings.displayZoomControls = false
            settings.allowFileAccess = false
            settings.userAgentString =
                "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
            webViewClient = object : WebViewClient() {
                override fun onPageFinished(view: WebView?, url: String?) {
                    if (!url.isNullOrBlank()) {
                        tabUrls[activeTabIndex] = url
                        webUrlInput.setText(url)
                        rebuildTabChips()
                    }
                }
            }
            webChromeClient = WebChromeClient()
        }
        webViewSlot.removeAllViews()
        webViewSlot.addView(
            wv,
            FrameLayout.LayoutParams(
                FrameLayout.LayoutParams.MATCH_PARENT,
                FrameLayout.LayoutParams.MATCH_PARENT
            )
        )
        activeWebView = wv
        val saved = tabBundles[activeTabIndex]
        if (saved != null) {
            wv.restoreState(saved)
        } else {
            wv.loadUrl(tabUrls[activeTabIndex])
        }
        return wv
    }

    private fun switchWebTab(newIndex: Int) {
        if (newIndex == activeTabIndex || newIndex !in tabUrls.indices) return
        activeWebView?.let { wv ->
            val bundle = Bundle()
            wv.saveState(bundle)
            tabBundles[activeTabIndex] = bundle
            wv.stopLoading()
        }
        activeTabIndex = newIndex
        rebuildTabChips()
        val wv = ensureActiveWebView()
        val saved = tabBundles[newIndex]
        if (saved != null) {
            wv.restoreState(saved)
        } else {
            wv.loadUrl(tabUrls[newIndex])
        }
        webUrlInput.setText(tabUrls[newIndex])
    }

    private fun navigateCurrentTab(rawInput: String) {
        val trimmed = rawInput.trim()
        if (trimmed.isEmpty()) return
        val targetUrl = if (trimmed.startsWith("http://") || trimmed.startsWith("https://")) {
            trimmed
        } else if (trimmed.contains('.') && !trimmed.contains(' ')) {
            "https://$trimmed"
        } else {
            "https://www.google.com/search?q=${trimmed.replace(" ", "+")}"
        }
        tabUrls[activeTabIndex] = targetUrl
        ensureActiveWebView().loadUrl(targetUrl)
    }

    /**
     * Tier 1 Warm Pause / Resume with 180ms smooth crossfade (zero data loss).
     */
    fun setWebLayerActive(active: Boolean) {
        uiHandler.post {
            if (active == isWebLayerVisible) return@post
            isWebLayerVisible = active
            appDrawerOverlay.visibility = View.GONE
            if (active) {
                val wv = ensureActiveWebView()
                wv.onResume()
                wv.resumeTimers()
                webWorkspaceContainer.visibility = View.VISIBLE
                webWorkspaceContainer.animate().alpha(1f).setDuration(180L).start()
            } else {
                activeWebView?.let { wv ->
                    val bundle = Bundle()
                    wv.saveState(bundle)
                    tabBundles[activeTabIndex] = bundle
                    wv.onPause()
                    wv.pauseTimers()
                }
                webWorkspaceContainer.animate()
                    .alpha(0f)
                    .setDuration(180L)
                    .withEndAction { webWorkspaceContainer.visibility = View.GONE }
                    .start()
            }
            onWorkspaceLayerChanged?.invoke(active)
        }
    }

    /**
     * Tier 2 Cold Bundle Snapshot on low Host RAM: frees Chromium renderer while preserving all tabs.
     */
    fun trimWebMemoryToColdBundle() {
        uiHandler.post {
            val wv = activeWebView ?: return@post
            val bundle = Bundle()
            wv.saveState(bundle)
            tabBundles[activeTabIndex] = bundle
            if (!isWebLayerVisible) {
                webViewSlot.removeAllViews()
                runCatching {
                    wv.stopLoading()
                    wv.onPause()
                    wv.destroy()
                }
                activeWebView = null
            }
        }
    }

    fun releaseWebResources() {
        uiHandler.post {
            activeWebView?.let { wv ->
                runCatching {
                    wv.stopLoading()
                    wv.onPause()
                    wv.destroy()
                }
            }
            activeWebView = null
        }
    }

