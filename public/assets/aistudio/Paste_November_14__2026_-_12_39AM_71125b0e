package com.example.host

import android.media.MediaCodec
import android.media.MediaCodecInfo
import android.media.MediaFormat
import android.os.Build
import android.os.Bundle
import android.view.Surface
import java.io.DataOutputStream
import java.util.concurrent.atomic.AtomicBoolean
import java.util.concurrent.atomic.AtomicLong

class H264StreamEncoder(
    private val width: Int,
    private val height: Int,
    private val bitrateMbps: Int,
    private val fps: Int = 60,
    private val onEncodedFrame: (ByteArray, Long) -> Unit,
    private val onMetrics: (fps: Int, kbps: Int) -> Unit
) {
    private var codec: MediaCodec? = null
    var inputSurface: Surface? = null
        private set

    private val running = AtomicBoolean(false)
    private var drainThread: Thread? = null
    private val lastSyncRequestMs = AtomicLong(0L)

    fun start(): Surface {
        val mediaCodec = MediaCodec.createEncoderByType(MediaFormat.MIMETYPE_VIDEO_AVC)
        val encCaps = runCatching {
            mediaCodec.codecInfo
                .getCapabilitiesForType(MediaFormat.MIMETYPE_VIDEO_AVC)
                ?.encoderCapabilities
        }.getOrNull()
        val chosenBitrateMode = selectBitrateMode(
            supportsCbr = encCaps?.isBitrateModeSupported(
                MediaCodecInfo.EncoderCapabilities.BITRATE_MODE_CBR
            ) == true,
            supportsVbr = encCaps?.isBitrateModeSupported(
                MediaCodecInfo.EncoderCapabilities.BITRATE_MODE_VBR
            ) == true
        )

        val profileCaps = runCatching {
            mediaCodec.codecInfo
                .getCapabilitiesForType(MediaFormat.MIMETYPE_VIDEO_AVC)
                ?.profileLevels
        }.getOrNull().orEmpty()
        val baselineLevel = profileCaps
            .filter { it.profile == MediaCodecInfo.CodecProfileLevel.AVCProfileBaseline }
            .maxOfOrNull { it.level }
            ?.coerceAtMost(MediaCodecInfo.CodecProfileLevel.AVCLevel31)
            ?: MediaCodecInfo.CodecProfileLevel.AVCLevel31

        val format = MediaFormat.createVideoFormat(MediaFormat.MIMETYPE_VIDEO_AVC, width, height).apply {
            setInteger(
                MediaFormat.KEY_COLOR_FORMAT,
                MediaCodecInfo.CodecCapabilities.COLOR_FormatSurface
            )
            setInteger(MediaFormat.KEY_BIT_RATE, bitrateMbps * 1_000_000)
            setInteger(MediaFormat.KEY_FRAME_RATE, fps)
            setInteger(MediaFormat.KEY_I_FRAME_INTERVAL, 1)
            // Repeat last frame after 100ms (in microseconds) so late-attaching decoders get frames
            setLong(MediaFormat.KEY_REPEAT_PREVIOUS_FRAME_AFTER, 100_000L)
            if (profileCaps.any { it.profile == MediaCodecInfo.CodecProfileLevel.AVCProfileBaseline }) {
                setInteger(MediaFormat.KEY_PROFILE, MediaCodecInfo.CodecProfileLevel.AVCProfileBaseline)
                setInteger(MediaFormat.KEY_LEVEL, baselineLevel)
            }
            if (chosenBitrateMode != null) {
                setInteger(MediaFormat.KEY_BITRATE_MODE, chosenBitrateMode)
            }
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
                setInteger(MediaFormat.KEY_MAX_B_FRAMES, 0)
            }
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
                setInteger(MediaFormat.KEY_LOW_LATENCY, 1)
            }
        }

        mediaCodec.configure(format, null, null, MediaCodec.CONFIGURE_FLAG_ENCODE)
        val surface = mediaCodec.createInputSurface()
        mediaCodec.start()

        codec = mediaCodec
        inputSurface = surface
        running.set(true)

        drainThread = Thread({ drainLoop(mediaCodec) }, "ExtDesk-H264Encoder").apply {
            start()
        }
        return surface
    }

    fun requestSyncFrameBurst() {
        val now = System.currentTimeMillis()
        if (now - lastSyncRequestMs.get() < 250L) return
        lastSyncRequestMs.set(now)
        runCatching {
            codec?.setParameters(Bundle().apply {
                putInt(MediaCodec.PARAMETER_KEY_REQUEST_SYNC_FRAME, 0)
            })
        }
    }

    fun stop() {
        running.set(false)
        runCatching { codec?.signalEndOfInputStream() }
        runCatching { drainThread?.join(500) }
        drainThread = null
        runCatching { codec?.stop() }
        runCatching { codec?.release() }
        codec = null
        inputSurface?.release()
        inputSurface = null
    }

    private fun drainLoop(mediaCodec: MediaCodec) {
        val info = MediaCodec.BufferInfo()
        var frameCount = 0
        var byteAccum = 0L
        var windowStartMs = System.currentTimeMillis()
        var configBytes: ByteArray? = null

        while (running.get()) {
            val outIndex = try {
                mediaCodec.dequeueOutputBuffer(info, 10_000L)
            } catch (_: Throwable) {
                break
            }
            if (outIndex >= 0) {
                val outBuf = mediaCodec.getOutputBuffer(outIndex)
                if (outBuf != null && info.size > 0) {
                    outBuf.position(info.offset)
                    outBuf.limit(info.offset + info.size)
                    val data = ByteArray(info.size)
                    outBuf.get(data)

                    if ((info.flags and MediaCodec.BUFFER_FLAG_CODEC_CONFIG) != 0) {
                        configBytes = data
                        onEncodedFrame(data, System.currentTimeMillis())
                    } else {
                        if ((info.flags and MediaCodec.BUFFER_FLAG_KEY_FRAME) != 0 && configBytes != null) {
                            onEncodedFrame(configBytes!!, System.currentTimeMillis())
                        }
                        onEncodedFrame(data, System.currentTimeMillis())
                        frameCount++
                        byteAccum += data.size
                    }
                }
                mediaCodec.releaseOutputBuffer(outIndex, false)
            }

            val now = System.currentTimeMillis()
            val elapsed = now - windowStartMs
            if (elapsed >= 1000L) {
                val measuredFps = ((frameCount * 1000f) / elapsed).toInt()
                val kbps = ((byteAccum * 8L) / elapsed).toInt()
                onMetrics(measuredFps, kbps)
                frameCount = 0
                byteAccum = 0L
                windowStartMs = now
            }
        }
    }

    companion object {
        fun selectBitrateMode(supportsCbr: Boolean, supportsVbr: Boolean): Int? = when {
            supportsCbr -> MediaCodecInfo.EncoderCapabilities.BITRATE_MODE_CBR
            supportsVbr -> MediaCodecInfo.EncoderCapabilities.BITRATE_MODE_VBR
            else -> null
        }

        fun writeLengthPrefixedFrame(out: DataOutputStream, nalBytes: ByteArray, probeTimestampMs: Long) {
            synchronized(out) {
                out.writeInt(nalBytes.size)
                out.writeLong(probeTimestampMs)
                out.write(nalBytes)
                out.flush()
            }
        }
    }
}

B. app/src/main/java/com/example/display/H264StreamDecoder.kt
Inspect Annex-B NAL start codes (7/8 -> BUFFER_FLAG_CODEC_CONFIG + csd-0 caching; 5 -> BUFFER_FLAG_KEY_FRAME), drain INFO_OUTPUT_FORMAT_CHANGED immediately, and auto-fall back to software H.264 on hardware failure:
package com.example.display

import android.media.MediaCodec
import android.media.MediaCodecList
import android.media.MediaFormat
import android.view.Surface
import com.example.model.LatencyProbeStats
import java.io.DataInputStream
import java.net.InetSocketAddress
import java.net.Socket
import java.nio.ByteBuffer
import java.util.concurrent.atomic.AtomicBoolean
import java.util.concurrent.atomic.AtomicLong

class H264StreamDecoder(
    private val onFirstOrResumedFrame: () -> Unit,
    private val onLatencyStats: (LatencyProbeStats) -> Unit,
    private val onStreamMetrics: (fps: Int) -> Unit,
    private val onDecoderStateChanged: (softwareFallback: Boolean, errorMessage: String?) -> Unit = { _, _ -> }
) {
    private val running = AtomicBoolean(false)
    private var videoSocket: Socket? = null
    private var codec: MediaCodec? = null
    private var workerThread: Thread? = null
    private var activeSurface: Surface? = null

    val lastFrameDecodedMs = AtomicLong(0L)
    private val latencyWindow = ArrayDeque<Long>(32)

    fun start(
        hostIp: String,
        videoPort: Int,
        width: Int,
        height: Int,
        outputSurface: Surface
    ) {
        if (running.get() && activeSurface === outputSurface && videoSocket?.isConnected == true) {
            return
        }
        stop()
        activeSurface = outputSurface
        running.set(true)
        lastFrameDecodedMs.set(System.currentTimeMillis())
        workerThread = Thread({
            runDecodeLoop(hostIp, videoPort, width, height, outputSurface)
        }, "ExtDesk-H264Decoder").apply {
            start()
        }
    }

    fun stop() {
        running.set(false)
        activeSurface = null
        runCatching { videoSocket?.close() }
        runCatching { workerThread?.join(400) }
        workerThread = null
        videoSocket = null
        releaseCodecQuietly(codec)
        codec = null
    }

    private fun runDecodeLoop(
        hostIp: String,
        videoPort: Int,
        width: Int,
        height: Int,
        outputSurface: Surface
    ) {
        var usingSoftware = false
        var cachedCsd0: ByteArray? = null

        try {
            val sock = Socket().apply {
                tcpNoDelay = true
                connect(InetSocketAddress(hostIp, videoPort), 5000)
            }
            videoSocket = sock
            val inp = DataInputStream(sock.getInputStream())

            var mediaCodec = createConfiguredDecoder(
                width = width,
                height = height,
                surface = outputSurface,
                preferSoftware = false,
                csd0 = null
            )
            if (mediaCodec == null) {
                usingSoftware = true
                mediaCodec = createConfiguredDecoder(
                    width = width,
                    height = height,
                    surface = outputSurface,
                    preferSoftware = true,
                    csd0 = null
                )
            }
            if (mediaCodec == null) {
                onDecoderStateChanged(false, "H.264 decoder unavailable on this Display")
                return
            }
            codec = mediaCodec
            onDecoderStateChanged(usingSoftware, null)

            val info = MediaCodec.BufferInfo()
            var frameCount = 0
            var fpsWindowStart = System.currentTimeMillis()

            while (running.get()) {
                val nalLen = inp.readInt()
                val probeTimestampMs = inp.readLong()
                if (nalLen <= 0 || nalLen > 4 * 1024 * 1024) break
                val nalBytes = ByteArray(nalLen)
                inp.readFully(nalBytes)

                val nalType = extractPrimaryNalType(nalBytes)
                val isConfig = nalType == 7 || nalType == 8
                val isKeyFrame = nalType == 5
                if (isConfig) {
                    cachedCsd0 = nalBytes
                }
                val bufferFlags = when {
                    isConfig -> MediaCodec.BUFFER_FLAG_CODEC_CONFIG
                    isKeyFrame -> MediaCodec.BUFFER_FLAG_KEY_FRAME
                    else -> 0
                }

                try {
                    queueAndDrain(
                        mediaCodec = mediaCodec!!,
                        nalBytes = nalBytes,
                        bufferFlags = bufferFlags,
                        probeTimestampMs = probeTimestampMs,
                        info = info,
                        onFrameRendered = {
                            lastFrameDecodedMs.set(System.currentTimeMillis())
                            onFirstOrResumedFrame()
                            frameCount++
                        }
                    )
                } catch (codecErr: Throwable) {
                    if (!usingSoftware) {
                        // Auto-fallback to software H.264 decoder (OMX.google / c2.android)
                        releaseCodecQuietly(mediaCodec)
                        usingSoftware = true
                        mediaCodec = createConfiguredDecoder(
                            width = width,
                            height = height,
                            surface = outputSurface,
                            preferSoftware = true,
                            csd0 = cachedCsd0
                        )
                        codec = mediaCodec
                        if (mediaCodec == null) {
                            onDecoderStateChanged(true, "HW & SW H.264 decode failed: ${codecErr.message}")
                            break
                        }
                        onDecoderStateChanged(true, null)
                        if (!isConfig) {
                            runCatching {
                                queueAndDrain(
                                    mediaCodec = mediaCodec,
                                    nalBytes = nalBytes,
                                    bufferFlags = bufferFlags,
                                    probeTimestampMs = probeTimestampMs,
                                    info = info,
                                    onFrameRendered = {
                                        lastFrameDecodedMs.set(System.currentTimeMillis())
                                        onFirstOrResumedFrame()
                                        frameCount++
                                    }
                                )
                            }
                        }
                    } else {
                        onDecoderStateChanged(true, "SW H.264 decoder error: ${codecErr.message}")
                        break
                    }
                }

                val now = System.currentTimeMillis()
                if (now - fpsWindowStart >= 1000L) {
                    onStreamMetrics(frameCount)
                    frameCount = 0
                    fpsWindowStart = now
                }
            }
        } catch (t: Throwable) {
            if (running.get()) {
                onDecoderStateChanged(usingSoftware, "Video stream interrupted: ${t.message ?: "closed"}")
            }
        }
    }

    private fun queueAndDrain(
        mediaCodec: MediaCodec,
        nalBytes: ByteArray,
        bufferFlags: Int,
        probeTimestampMs: Long,
        info: MediaCodec.BufferInfo,
        onFrameRendered: () -> Unit
    ) {
        val inIdx = mediaCodec.dequeueInputBuffer(10_000L)
        if (inIdx >= 0) {
            val inBuf = mediaCodec.getInputBuffer(inIdx)
            if (inBuf != null) {
                inBuf.clear()
                inBuf.put(nalBytes)
                mediaCodec.queueInputBuffer(
                    inIdx,
                    0,
                    nalBytes.size,
                    System.nanoTime() / 1000L,
                    bufferFlags
                )
            }
        }

        var outIdx = mediaCodec.dequeueOutputBuffer(info, 5_000L)
        while (outIdx >= 0 || outIdx == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED) {
            if (outIdx == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED) {
                outIdx = mediaCodec.dequeueOutputBuffer(info, 5_000L)
                continue
            }
            mediaCodec.releaseOutputBuffer(outIdx, true)
            onFrameRendered()
            if (probeTimestampMs > 0L) {
                val elapsed = (System.currentTimeMillis() - probeTimestampMs).coerceAtLeast(1L)
                recordLatencySample(elapsed)
            }
            outIdx = mediaCodec.dequeueOutputBuffer(info, 0L)
        }
    }

    private fun createConfiguredDecoder(
        width: Int,
        height: Int,
        surface: Surface,
        preferSoftware: Boolean,
        csd0: ByteArray?
    ): MediaCodec? {
        return try {
            val format = MediaFormat.createVideoFormat(MediaFormat.MIMETYPE_VIDEO_AVC, width, height)
            if (csd0 != null) {
                format.setByteBuffer("csd-0", ByteBuffer.wrap(csd0))
            }
            val codecInstance = if (preferSoftware) {
                val swName = findSoftwareAvcDecoderName() ?: "OMX.google.h264.decoder"
                MediaCodec.createByCodecName(swName)
            } else {
                MediaCodec.createDecoderByType(MediaFormat.MIMETYPE_VIDEO_AVC)
            }
            codecInstance.configure(format, surface, null, 0)
            codecInstance.start()
            codecInstance
        } catch (_: Throwable) {
            null
        }
    }

    private fun findSoftwareAvcDecoderName(): String? {
        val infos = runCatching {
            MediaCodecList(MediaCodecList.REGULAR_CODECS).codecInfos
        }.getOrNull().orEmpty()
        return infos.firstOrNull { info ->
            !info.isEncoder &&
                info.supportedTypes.any { it.equals(MediaFormat.MIMETYPE_VIDEO_AVC, ignoreCase = true) } &&
                (info.name.startsWith("OMX.google.", ignoreCase = true) ||
                    info.name.startsWith("c2.android.", ignoreCase = true))
        }?.name
    }

    private fun releaseCodecQuietly(target: MediaCodec?) {
        runCatching { target?.stop() }
        runCatching { target?.release() }
    }

    private fun recordLatencySample(elapsedMs: Long) {
        synchronized(latencyWindow) {
            if (latencyWindow.size >= 25) {
                latencyWindow.removeFirst()
            }
            latencyWindow.addLast(elapsedMs)
            val sorted = latencyWindow.sorted()
            val median = sorted[sorted.size / 2]
            onLatencyStats(
                LatencyProbeStats(
                    lastTouchToFrameMs = elapsedMs,
                    medianTouchToFrameMs = median,
                    sampleCount = sorted.size
                )
            )
        }
    }

    companion object {
        /**
         * Inspects 3-byte (00 00 01) and 4-byte (00 00 00 01) Annex-B start codes to identify NAL type.
         */
        fun extractPrimaryNalType(bytes: ByteArray): Int {
            var i = 0
            while (i + 3 < bytes.size) {
                if (bytes[i] == 0.toByte() && bytes[i + 1] == 0.toByte()) {
                    if (bytes[i + 2] == 1.toByte()) {
                        return bytes[i + 3].toInt() and 0x1F
                    }
                    if (i + 4 < bytes.size && bytes[i + 2] == 0.toByte() && bytes[i + 3] == 1.toByte()) {
                        return bytes[i + 4].toInt() and 0x1F
                    }
                }
                i++
            }
            return -1
        }
    }
}

