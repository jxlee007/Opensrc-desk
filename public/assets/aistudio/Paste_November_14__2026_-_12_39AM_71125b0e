            @SuppressLint("ClickableViewAccessibility")
            setOnTouchListener { v, ev ->
                if (ev.actionMasked == MotionEvent.ACTION_DOWN ||
                    ev.actionMasked == MotionEvent.ACTION_MOVE ||
                    ev.actionMasked == MotionEvent.ACTION_UP
